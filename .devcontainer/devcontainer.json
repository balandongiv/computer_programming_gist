{
  "name": "Computer Programming",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip setuptools wheel && if [ -f requirements.txt ]; then .venv/bin/pip install -r requirements.txt; else echo 'No requirements.txt found, skipping.'; fi",
  "postStartCommand": "if [ -d .venv ]; then .venv/bin/pip install --upgrade pip setuptools wheel && if [ -f requirements.txt ]; then .venv/bin/pip install -r requirements.txt; fi; else echo '.venv not found; creating now...' && python -m venv .venv && .venv/bin/pip install --upgrade pip setuptools wheel && if [ -f requirements.txt ]; then .venv/bin/pip install -r requirements.txt; fi; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        // 🐍 --- Core Python Support ---
        "ms-python.python",                // Required: Main Python extension (language, run/debug, etc.)
        "ms-python.vscode-pylance",        // Required: Fast, smart IntelliSense and type checking
        "ms-python.debugpy",               // Required: Python debugger backend

        // 🧹 --- Code Formatting & Linting ---
        "ms-python.black-formatter",       // Recommended: Auto-formats code using Black
        "ms-python.isort",                 // Recommended: Sorts imports automatically
        "ms-python.flake8",                // Optional: Traditional linter for style and basic errors
        "charliermarsh.ruff",              // Optional: Ultra-fast linter and formatter alternative

        // 📓 --- Jupyter Notebook Support ---
        "ms-toolsai.jupyter",              // Required: Enables running Jupyter notebooks in VS Code
        "ms-toolsai.jupyter-keymap",       // Optional: Adds Jupyter-style keybindings
        "ms-toolsai.jupyter-renderers",    // Optional: Improves rendering of tables and charts in notebooks

        // 🧮 --- Data Tools ---
        "ms-toolsai.datawrangler",         // Recommended: Visual DataFrame explorer & cleaner
        "randomfractalsinc.vscode-data-preview", // Optional: Preview CSV, JSON, and Parquet data files

        // ⚙️ --- Environment & Execution Utilities ---
        "formulahendry.code-runner",       // Optional: Quickly run code snippets without full debug
        "donjayamanne.python-environment-manager", // Optional: Manage venv/conda environments easily

        // 🤖 --- AI & IntelliSense Enhancements ---
        "visualstudioexptteam.vscodeintellicode",  // Recommended: AI-assisted code completions

        // 🌳 --- Version Control & Git ---
        "mhutchie.git-graph",              // Recommended: Visual Git history graph inside VS Code

        // 🧠 --- Productivity & Quality-of-Life ---
        "aaron-bond.better-comments",      // Optional: Color-code TODO, FIXME, NOTE, etc.
        "usernamehw.errorlens",            // Optional: Show linting errors directly inline
        "streetsidesoftware.code-spell-checker", // Optional: Detect typos in comments and strings

        // 🧾 --- Documentation / Markdown Enhancements ---
        "yzhang.markdown-all-in-one",      // Optional: Adds Markdown formatting, TOC, and shortcuts
        "shd101wyy.markdown-preview-enhanced" // Optional: Advanced Markdown and math preview rendering
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.analysis.typeCheckingMode": "basic",
        "python.linting.enabled": true,
        "python.formatting.provider": "black",
        "python.debugging.justMyCode": false,
        "python.debugger.showReturnValue": true,
        "debug.allowBreakpointsEverywhere": true,
        "debug.toolBarLocation": "docked",
        "debug.openDebug": "openOnSessionStart",
        "debug.showVariables": true,
        "jupyter.variableQueries.enabled": true,
        "jupyter.variableDataExplorer": true,
        "jupyter.interactiveWindowMode": "perFile",
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/.ipynb_checkpoints": true,
          "**/__pycache__": true
        },
        "editor.mouseWheelZoom": true,
        "window.zoomLevel": 0,          // optional: ensure UI zoom stays normal
        "editor.fontSize": 16           // optional: set your default editor size
      }
    }
  },
  "remoteUser": "vscode"
}
