{
  "name": "Beginner Python Class",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "python -m venv .venv && . .venv/bin/activate && pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi",
  "postStartCommand": ". .venv/bin/activate && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        // --- Core Python & Jupyter environment ---
        "ms-python.python",                  // Main Python support (syntax, run, debug)
        "ms-toolsai.jupyter",                // Enable Jupyter Notebook and interactive cells
        "ms-toolsai.jupyter-keymap",         // Keyboard shortcuts for Jupyter
        "ms-toolsai.jupyter-renderers",      // Rich notebook outputs (plots, HTML, etc.)
        "ms-python.vscode-pylance",          // Python language server (IntelliSense)

        // --- Code formatting & organization ---
        "ms-python.black-formatter",         // Auto-format Python code
        "ms-python.isort",                   // Organize imports automatically

        // --- Debugging tools ---
        "ms-python.debugpy",                 // Debugger backend
        "formulahendry.code-runner",         // Quick run button for scripts
        "donjayamanne.python-environment-manager", // Manage virtual environments
        "visualstudioexptteam.vscodeintellicode",  // Smart code completion
        "mhutchie.git-graph"                 // Visualize commits (for student submissions)
      ],
      "settings": {
        // --- Python environment ---
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.formatting.provider": "black",
        "python.analysis.typeCheckingMode": "basic",
        "python.linting.enabled": true,

        // --- Debugging ---
        "python.debugging.justMyCode": false,
        "python.debugger.showReturnValue": true,
        "debug.allowBreakpointsEverywhere": true,
        "debug.toolBarLocation": "docked",
        "debug.openDebug": "openOnSessionStart",
        "debug.showVariables": true,

        // --- Jupyter Notebook variable viewer ---
        "jupyter.variableQueries.enabled": true,
        "jupyter.variableDataExplorer": true,
        "jupyter.interactiveWindowMode": "perFile",

        // --- Editor preferences ---
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/.ipynb_checkpoints": true,
          "**/__pycache__": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
